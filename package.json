{
  "name": "bumpa-achievement-system",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven achievement, badge, and cashback system for the Bumpa senior backend assessment.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build -w packages/events-sdk && npm run build -w packages/config-sdk && npm run build -w packages/logger-sdk && npm run build -w packages/broker-sdk && npm run build -w packages/outbox-sdk",
    "build:apps": "npm run build -w apps/api-gateway && npm run build -w apps/purchase-service && npm run build -w apps/loyalty-service && npm run build -w apps/cashback-service",
    "lint": "eslint \"{apps,packages}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=e2e",
    "test:e2e": "jest --runInBand --testMatch \"**/*.e2e-spec.ts\"",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,json,md}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "start:api": "npm run start:dev -w apps/api-gateway",
    "start:purchase": "npm run start:dev -w apps/purchase-service",
    "start:loyalty": "npm run start:dev -w apps/loyalty-service",
    "start:cashback": "npm run start:dev -w apps/cashback-service"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/microservices": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "amqplib": "^0.10.8",
    "bullmq": "^5.58.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.7.0",
    "nanoid": "^5.1.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.26",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.20",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.33.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "packages/**/*.ts",
      "!**/*.module.ts",
      "!**/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@bumpa/broker-sdk$": "<rootDir>/packages/broker-sdk/src",
      "^@bumpa/config-sdk$": "<rootDir>/packages/config-sdk/src",
      "^@bumpa/events-sdk$": "<rootDir>/packages/events-sdk/src",
      "^@bumpa/logger-sdk$": "<rootDir>/packages/logger-sdk/src",
      "^@bumpa/outbox-sdk$": "<rootDir>/packages/outbox-sdk/src"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
