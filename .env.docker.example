# Only the variables below actually affect `docker compose up` (docker-compose.yml).
#
# Everything else — DB/RabbitMQ/Redis host, user, password, and ports, outbox tuning —
# is hardcoded directly in docker-compose.yml on purpose. Those are internal
# container-to-container settings (e.g. DATABASE_HOST=postgres is a Docker network name,
# not a real "configurable" setting), not something meant to vary per environment. See the
# comment above the api-gateway service in docker-compose.yml for why.
#
# Copy this file to `.env` at the repo root — Docker Compose auto-loads it — and fill in
# real values as needed. `.env` is git-ignored; it will never be committed.

# Payment provider: "mock" (default, no external calls, cashback is instant/synchronous)
# or "paystack" (real transfers, requires a real secret key, cashback is PENDING until
# a webhook confirms it).
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
CASHBACK_AMOUNT_KOBO=30000

# Shared-secret gate for /admin/* and /cashbacks* on the gateway (see README's
# "Admin & cashback access" section). Not user authentication — just a shared secret.
ADMIN_API_KEY=bumpa-local-admin-key

# Host port the gateway is published on.
API_GATEWAY_HOST_PORT=3000

# --- Only used with docker-compose.dev.yml (npm run docker:dev) ---
# Uncomment to remap if the default port is already taken on your machine (e.g. by a
# native Postgres/Redis/RabbitMQ install).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_MANAGEMENT_HOST_PORT=15672
# PURCHASE_SERVICE_HOST_PORT=3001
# LOYALTY_SERVICE_HOST_PORT=3002
# CASHBACK_SERVICE_HOST_PORT=3004
